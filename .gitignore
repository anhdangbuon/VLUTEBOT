# Virtual environment
.venv/
env/
venv/
ENV/

# Python cache & test artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environment variables & secrets (NEVER commit API keys)
.env
.env.local
.env.*
.streamlit/secrets.toml

# Temporary ChromaDB swap/backup directories (chroma_db/ chính thức được giữ để chạy ngay khi clone/deploy)
chroma_db_temp/
chroma_db_old/

# IDE settings
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/

# OS & MS Office temporary lock files
.DS_Store
Thumbs.db
~$*

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/

# Logs & large compressed benchmark archives (> GitHub limit)
*.log
evaluation/*.gz
